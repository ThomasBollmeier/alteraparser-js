{
  "name": "alteraparser",
  "version": "3.1.1",
  "description": "ES6 JavaScript parser generator for building Abstract Syntax Trees from text input. Browser-compatible, no dependencies.",
  "type": "module",
  "main": "dist/alteraparser-3.1.0.cjs",
  "module": "dist/alteraparser-3.1.0.esm.js",
  "browser": "dist/alteraparser-3.1.0.umd.js",
  "exports": {
    ".": {
      "import": "./dist/alteraparser-3.1.0.esm.js",
      "require": "./dist/alteraparser-3.1.0.cjs",
      "default": "./dist/alteraparser-3.1.0.esm.js"
    },
    "./esm": "./dist/alteraparser-3.1.0.esm.js",
    "./cjs": "./dist/alteraparser-3.1.0.cjs",
    "./umd": "./dist/alteraparser-3.1.0.umd.js"
  },
  "keywords": [
    "parser",
    "grammar",
    "lexer",
    "ast",
    "parser-generator",
    "es6",
    "esm"
  ],
  "author": "Thomas Bollmeier",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasbollmeier/alteraparser-js.git"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "rollup": "^4.65.0",
    "terser": "^5.51.2"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE"
  ]
}
